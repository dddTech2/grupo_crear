---
import { contacto, waBase, telLink, mailtoLink } from '../data/contacto';
import NyoCredit from './NyoCredit.astro';

// Año calculado en build time. El script del cliente lo actualiza en runtime
// por si el sitio no se rebuilds el 1 de enero.
const year = new Date().getFullYear();

// ── Vínculos legales ──────────────────────────────────────────────────────────
const legalLinks: { label: string; href: string; active: boolean }[] = [
  { label: 'Política de privacidad',          href: '/politica-de-privacidad',           active: false },
  { label: 'Términos y condiciones',          href: '/terminos-y-condiciones',           active: false },
  { label: 'Tratamiento de datos personales', href: '/politica-de-tratamiento-de-datos', active: false },
];

const activeLinks = legalLinks.filter((l) => l.active);
---

<footer class="site-footer">
  <!-- Luz ambiental superior -->
  <div class="foot-ambient-glow" aria-hidden="true"></div>
  <div class="foot-top-border" aria-hidden="true"></div>

  <div class="foot-container">

    <!-- ── 1. MAIN GRID LAYOUT ───────────────────────────────────────────── -->
    <div class="foot-main-grid">

      <!-- Columna 1: Marca & Contacto rápido -->
      <div class="foot-col-brand">
        <a href="/" class="foot-logo-link" aria-label="Grupo Crear — Inicio">
          <div class="foot-logo-wrap" aria-hidden="true">
            <!-- Reutiliza el logo del encabezado en lugar de repetir sus 16 KB en el HTML -->
            <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg"><use href="#site-logo" /></svg>
          </div>
        </a>
        <p class="foot-brand-desc">
          Agencia de publicidad y producción gráfica integral en Colombia. Transformamos visiones comerciales en realidades visuales extraordinarias.
        </p>

        <div class="foot-contact-quick">
          <a href={mailtoLink} class="foot-contact-chip">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            <span>{contacto.email}</span>
          </a>
          <a href={telLink} class="foot-contact-chip">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <span>+57 {contacto.telefonoDisplay}</span>
          </a>
        </div>
      </div>

      <!-- Columna 2: Servicios -->
      <nav class="foot-col" aria-label="Servicios">
        <h3 class="fcol-head">Servicios</h3>
        <ul role="list" class="fcol-list">
          <li>
            <a href="/servicios/impresion-gran-formato">
              <span class="arrow-icon">›</span> Gran Formato &amp; Vallas
            </a>
          </li>
          <li>
            <a href="/servicios/material-pop">
              <span class="arrow-icon">›</span> Material POP
            </a>
          </li>
          <li>
            <a href="/servicios/branding-identidad">
              <span class="arrow-icon">›</span> Branding &amp; Identidad
            </a>
          </li>
          <li>
            <a href="/servicios/diseno-web">
              <span class="arrow-icon">›</span> Diseño &amp; Desarrollo Web
            </a>
          </li>
          <li>
            <a href="/servicios/fotografia-publicitaria">
              <span class="arrow-icon">›</span> Fotografía Publicitaria
            </a>
          </li>
          <li>
            <a href="/servicios/campanas-integrales">
              <span class="arrow-icon">›</span> Campañas Integrales
            </a>
          </li>
        </ul>
      </nav>

      <!-- Columna 3: Estudio / Navegación -->
      <nav class="foot-col" aria-label="Estudio">
        <h3 class="fcol-head">Estudio</h3>
        <ul role="list" class="fcol-list">
          <li>
            <a href="/#nos">
              <span class="arrow-icon">›</span> Nosotros
            </a>
          </li>
          <li>
            <a href="/#port">
              <span class="arrow-icon">›</span> Portafolio de Trabajo
            </a>
          </li>
          <li>
            <a href="/servicios">
              <span class="arrow-icon">›</span> Catálogo de Servicios
            </a>
          </li>
          <li>
            <a href="/#cto">
              <span class="arrow-icon">›</span> Cotización &amp; Contacto
            </a>
          </li>
        </ul>
      </nav>

      <!-- Columna 4: Síguenos & Redes -->
      <div class="foot-col" aria-label="Redes Sociales">
        <h3 class="fcol-head">Síguenos</h3>
        <div class="foot-social-pills">
          <a href="#" class="social-pill" aria-label="Instagram de Grupo Crear" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
            <span>Instagram</span>
          </a>
          <a href="#" class="social-pill" aria-label="LinkedIn de Grupo Crear" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
            <span>LinkedIn</span>
          </a>
          <a href="#" class="social-pill" aria-label="Behance de Grupo Crear" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <path d="M22 7h-7V5h7v2zm-1.7 5.2c-.2-1.3-1.2-2.2-2.8-2.2-1.8 0-3 1.3-3 3.3 0 2 1.2 3.4 3.1 3.4 1.4 0 2.5-.7 2.8-1.8h-1.9c-.1.4-.4.6-.9.6-.7 0-1.1-.4-1.2-1.1h4c0-.2.1-.8.1-1.2zm-3.9-.6c.1-.6.5-1 1.1-1 .6 0 1 .4 1.1 1h-2.2zm-7.9-2.6h-4.5v10h4.6c2.4 0 3.7-1.1 3.7-2.7 0-1.2-.6-2-1.6-2.4.8-.4 1.3-1.2 1.3-2.3 0-1.6-1.3-2.6-3.5-2.6zm-2.3 1.9h2c1 0 1.6.4 1.6 1.1 0 .8-.6 1.2-1.6 1.2h-2v-2.3zm2.2 6.3h-2.2v-2.4h2.2c1.1 0 1.8.4 1.8 1.2 0 .8-.7 1.2-1.8 1.2z"/>
            </svg>
            <span>Behance</span>
          </a>
          <a href={waBase} target="_blank" class="social-pill wa-pill" aria-label="WhatsApp 24/7" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/>
            </svg>
            <span>WhatsApp 24/7</span>
          </a>
        </div>
      </div>

    </div>

    <!-- ── 2. VÍNCULOS LEGALES (SI EXISTEN ACTIVOS) ────────────────────── -->
    {activeLinks.length > 0 && (
      <nav aria-label="Vínculos legales" class="foot-legal-nav">
        <ul role="list" class="foot-legal-list">
          {activeLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <!-- ── 3. FOOTER BOTTOM BAR ─────────────────────────────────────────── -->
    <div class="foot-bottom-bar">
      <p class="foot-copyright">
        © <span id="foot-year">{year}</span> <strong>Grupo Crear</strong>. Todos los derechos reservados.
      </p>
      
      <div class="foot-location">
        <span class="location-dot"></span>
        <span>Bogotá · Colombia</span>
      </div>

      <NyoCredit class="foot-credit" />
    </div>

  </div>
</footer>

<style is:global>
  /* Reset nav override del layout global */
  footer nav {
    position: static;
    inset: auto;
    z-index: auto;
    height: auto;
    display: block;
    align-items: normal;
    justify-content: normal;
    padding: 0;
    transition: none;
    border-bottom: none;
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .site-footer {
    position: relative;
    background: linear-gradient(180deg, #00122e 0%, #000814 100%);
    color: var(--w);
    padding: 0 clamp(20px, 5vw, 64px) 36px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
    isolation: isolate;
  }

  .foot-ambient-glow {
    position: absolute;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 90vw;
    max-width: 1000px;
    height: 300px;
    background: radial-gradient(ellipse at 50% 0%, rgba(232, 78, 27, 0.16), transparent 70%);
    pointer-events: none;
    z-index: -1;
  }

  .foot-top-border {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(232, 78, 27, 0.6) 50%, transparent);
    z-index: 2;
  }

  .foot-container {
    max-width: 1240px;
    margin: 0 auto;
  }

  /* ── 1. GRID PRINCIPAL ────────────────────────────────────────────────── */
  .foot-main-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.2fr;
    gap: clamp(32px, 4vw, 64px);
    padding: clamp(48px, 6vw, 72px) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .foot-col-brand {
    display: flex;
    flex-direction: column;
  }

  .foot-logo-link {
    display: inline-block;
    text-decoration: none;
    transition: transform 0.3s var(--ease);
    margin-bottom: 18px;
    width: fit-content;
  }

  .foot-logo-link:hover {
    transform: scale(1.02);
  }

  .foot-logo-wrap {
    width: 240px;
    height: 64px;
    filter: drop-shadow(0 4px 12px rgba(232, 78, 27, 0.15));
  }

  .foot-logo-wrap svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .foot-brand-desc {
    color: var(--w60);
    font-size: 14px;
    line-height: 1.6;
    max-width: 340px;
    margin-bottom: 24px;
  }

  .foot-contact-quick {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .foot-contact-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--w60);
    text-decoration: none;
    font-size: 13px;
    padding: 8px 14px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    width: fit-content;
    transition: all 0.3s ease;
  }

  .foot-contact-chip svg {
    color: var(--n);
  }

  .foot-contact-chip:hover {
    color: #fff;
    background: rgba(232, 78, 27, 0.1);
    border-color: rgba(232, 78, 27, 0.3);
    transform: translateX(3px);
  }

  /* Columnas de navegación */
  .fcol-head {
    font-family: 'Sofia Sans Condensed', sans-serif;
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--n);
    margin-bottom: 20px;
    font-weight: 700;
  }

  .fcol-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .fcol-list a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--w60);
    text-decoration: none;
    font-size: 14px;
    transition: all 0.3s ease;
  }

  .arrow-icon {
    font-size: 12px;
    color: var(--n);
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.3s ease;
  }

  .fcol-list a:hover {
    color: #fff;
    transform: translateX(4px);
  }

  .fcol-list a:hover .arrow-icon {
    opacity: 1;
    transform: translateX(0);
  }

  .fcol-list a:focus-visible {
    outline: 2px solid var(--n);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* Redes sociales pills */
  .foot-social-pills {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .social-pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--w60);
    text-decoration: none;
    font-size: 13.5px;
    padding: 10px 16px;
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    transition: all 0.3s ease;
  }

  .social-pill:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateX(4px);
  }

  .social-pill.wa-pill {
    background: rgba(37, 211, 102, 0.08);
    border-color: rgba(37, 211, 102, 0.2);
    color: #25D366;
  }

  .social-pill.wa-pill:hover {
    background: rgba(37, 211, 102, 0.2);
    border-color: rgba(37, 211, 102, 0.4);
    color: #fff;
  }

  /* ── 2. LEGALES ────────────────────────────────────────────────────────── */
  .foot-legal-nav {
    padding: 20px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .foot-legal-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .foot-legal-list a {
    color: var(--w40);
    text-decoration: none;
    font-size: 12px;
    transition: color 0.25s ease;
  }

  .foot-legal-list a:hover {
    color: var(--w60);
  }

  /* ── 3. BOTTOM BAR CON ESPACIO DE SEGURIDAD ──────────────────────────── */
  .foot-bottom-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    padding-top: 32px;
    /* MARGEN DE SEGURIDAD EN LA DERECHA:
       Evita que los botones flotantes de WhatsApp y Chat IA oculten el texto */
    padding-right: clamp(20px, 10vw, 110px);
    font-size: 13px;
    color: var(--w40);
  }

  .foot-copyright strong {
    color: var(--w60);
    font-weight: 500;
  }

  .foot-location {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Sofia Sans Condensed', sans-serif;
    letter-spacing: 0.05em;
  }

  .location-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--n);
  }

  /* El ancho reservado evita que la animación del logo mueva la fila */
  .foot-credit {
    font-family: 'Sofia Sans Condensed', sans-serif;
    letter-spacing: 0.05em;
    color: var(--w60);
    min-width: 13em;
  }

  /* ── RESPONSIVE ──────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .foot-main-grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    .foot-col-brand {
      grid-column: span 2;
    }
    .foot-bottom-bar {
      padding-right: 90px;
    }
  }

  @media (max-width: 680px) {
    .foot-main-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .foot-col-brand {
      grid-column: span 1;
    }
    .foot-bottom-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      padding-right: 0;
      /* En móviles, añadimos margen inferior amplio para dar espacio a los widgets flotantes */
      padding-bottom: 70px;
    }
  }
</style>

<script>
  // Garantiza que el año sea el actual independientemente del último build date.
  const el = document.getElementById('foot-year');
  if (el) el.textContent = String(new Date().getFullYear());
</script>
