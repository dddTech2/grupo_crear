---
/*
  Cursor cohete: usa el MISMO path del cohete del isotipo (primer path naranja
  de /public/logo-Grupo-Crear-vector_sintext.svg), así cursor, logo y favicon
  son la misma silueta. En el logo el cohete va inclinado ~45°; aquí se
  endereza (rotate(-45)) y se escala a un viewBox 36×36 con la nariz arriba,
  porque el script lo rota según la dirección del movimiento (+90°).

  Geometría medida en el logo (coordenadas ya rotadas −45°):
    eje x ≈ 666 · nariz y ≈ −476 · tobera y ≈ −188 · alto 307.6
  k = 26 / 307.6 → el cohete ocupa y 1.5…27.5 y la llama sale de y ≈ 25.8.
*/
import { readFileSync } from 'node:fs';
import { resolve }      from 'node:path';

let rocketD = '';
try {
  const svgRaw = readFileSync(resolve('public/logo-Grupo-Crear-vector_sintext.svg'), 'utf-8');
  rocketD = svgRaw.match(/<path\s+class="b"\s+d="([^"]+)"/)?.[1] ?? '';
} catch (_) {}
---

<div id="rocketCursor" aria-hidden="true">
  <svg
    id="rocket-svg"
    width="42"
    height="42"
    viewBox="0 0 36 36"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    shape-rendering="geometricPrecision"
    style="display:block;filter:drop-shadow(0 3px 8px rgba(232,78,27,.45));"
  >
    <!-- Llama del motor (escala reactiva a velocidad), detrás del cuerpo -->
    <g id="rocket-flame" style="transform-origin:18.2px 25.8px;">
      <ellipse cx="18.2" cy="29.6" rx="2.9" ry="4.4" fill="#E84E1B" opacity="0.9"/>
      <ellipse cx="18.2" cy="30.8" rx="1.8" ry="3.1" fill="#ff8c42" opacity="0.85"/>
      <ellipse cx="18.2" cy="31.6" rx="0.9" ry="1.8" fill="#fff"    opacity="0.75"/>
    </g>
    <!-- Cohete del isotipo, enderezado -->
    <g transform="translate(-38.28 41.72) scale(0.0845) rotate(-45)">
      <!-- La ventana del logo es un hueco: se rellena para que no deje ver la página -->
      <circle cx="737.5" cy="206.6" r="20" fill="#001433"/>
      <path d={rocketD} fill="#E84E1B"/>
    </g>
  </svg>
</div>

<script>
import { gsap } from 'gsap';

(function () {
  if (!window.matchMedia('(pointer: fine)').matches) return;

  var cursor = document.getElementById('rocketCursor');
  var svg    = document.getElementById('rocket-svg');
  var flame  = document.getElementById('rocket-flame');
  if (!cursor || !svg || !flame) return;

  gsap.to(cursor, { opacity: 1, duration: 0.2 });

  var mx = window.innerWidth / 2, my = window.innerHeight / 2;
  var px = mx, py = my;
  var cx = mx, cy = my;

  var THRESHOLD = 7;
  var activeP = 0, MAX_P = 18;

  var moveX = gsap.quickTo(cursor, 'x', { duration: 0.1, ease: 'power2.out' });
  var moveY = gsap.quickTo(cursor, 'y', { duration: 0.1, ease: 'power2.out' });

  window.addEventListener('mousemove', function (e) { mx = e.clientX; my = e.clientY; });

  // Delegación de eventos para aplicar la clase .hot al cursor en elementos interactivos
  document.body.addEventListener('mouseover', function (e) {
    var target = e.target as HTMLElement | null;
    if (!target) return;
    var interactive = target.closest('a, button, input, select, textarea, .srow, .proj, .gal-pill, .sn-pill, .bc, .gal-item, .otro-card, .btn-line, .btn-fill, [role="button"]');
    if (interactive) {
      cursor!.classList.add('hot');
    }
  });

  document.body.addEventListener('mouseout', function (e) {
    var target = e.target as HTMLElement | null;
    if (!target) return;
    var interactive = target.closest('a, button, input, select, textarea, .srow, .proj, .gal-pill, .sn-pill, .bc, .gal-item, .otro-card, .btn-line, .btn-fill, [role="button"]');
    if (interactive) {
      cursor!.classList.remove('hot');
    }
  });

  function spawn(x: number, y: number) {
    if (activeP >= MAX_P) return;
    activeP++;
    var p  = document.createElement('span');
    p.className = 'spark';
    var sz = 3 + Math.random() * 4;
    p.style.cssText =
      'width:' + sz + 'px;height:' + sz + 'px;' +
      'left:' + (x + (Math.random() - .5) * 18) + 'px;' +
      'top:'  + (y + 8 + Math.random() * 10)    + 'px;opacity:1;';
    document.body.appendChild(p);
    gsap.to(p, {
      y: 18 + Math.random() * 18,
      x: (Math.random() - .5) * 22,
      opacity: 0, scale: .15,
      duration: .4 + Math.random() * .3,
      ease: 'power1.out',
      onComplete: function () { p.remove(); activeP--; },
    });
  }

  function tick() {
    var dx  = mx - px, dy = my - py;
    var vel = Math.hypot(dx, dy);

    cx += (mx - cx) * 0.16;
    cy += (my - cy) * 0.16;

    moveX(cx - 21);
    moveY(cy - 21);

    if (vel > 0.4) {
      var angle = Math.atan2(dy, dx) * (180 / Math.PI) + 90;
      gsap.to(svg, { rotation: angle, duration: 0.14, ease: 'power1.out', transformOrigin: '50% 50%' });
    }

    var fScale = Math.min(2, Math.max(0.5, 0.5 + vel * 0.07));
    gsap.to(flame, { scaleY: fScale, duration: 0.09, ease: 'power1.out' });

    if (vel > THRESHOLD) spawn(cx, cy);

    px = mx; py = my;
    requestAnimationFrame(tick);
  }

  tick();
})();
</script>
