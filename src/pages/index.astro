  .card-parallax {
    box-shadow: 0 24px 60px rgba(0,0,0,.55), 0 0 0 1px rgba(255,255,255,.06);
    backface-visibility: hidden;
  }

  /* Mobile responsivo — mismo efecto que desktop */
  @media (max-width: 768px) {
    /* Meteor más pequeño para no bloquear las tarjetas en pantallas estrechas */
    #meteor-inner {
      width:  70vw !important;
      height: 70vw !important;
    }
    /* Las tarjetas usan max-width para no desbordar el viewport en mobile.
       Se preserva la posición absoluta porcentual para que la animación
       de dispersión funcione igual que en desktop. */
    .card-parallax {
      max-width: 44vw;
    }
    /* La tarjeta circular mantiene proporciones */
    .card-parallax.rounded-full {
      max-width: 28vw !important;
      height: 28vw !important;
    }
  }
</style>
