---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import ContactDialog from '../../components/ContactDialog.astro';
import RocketCursor from '../../components/RocketCursor.astro';
import EntregablesSection from '../../components/EntregablesSection.astro';
import CierreCTA from '../../components/CierreCTA.astro';
import { servicios } from '../../data/servicios';
import type { Servicio, Foto } from '../../data/servicios';
import { waBase } from '../../data/contacto';

export function getStaticPaths() {
  return servicios.map(s => ({
    params: { slug: s.slug },
    props:  { servicio: s },
  }));
}

const { servicio: s } = Astro.props as { servicio: Servicio };

const otros    = servicios.filter(x => x.slug !== s.slug);
const hayFotos = s.fotos.length > 0;
// ── Film strips para galería de sub-página ────────────────────────────────
// Misma lógica que index.astro: shuffle + split no superpuesto.
// Cada foto aparece en UNA sola columna → imposible verla duplicada.

function seededShuffle<T>(arr: T[], seed: number): T[] {
  const copy = [...arr];
  let state = (seed * 1664525 + 1013904223) >>> 0;
  const rnd = () => {
    state = (state * 1664525 + 1013904223) >>> 0;
    return state / 0x100000000;
  };
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(rnd() * (i + 1));
    [copy[i], copy[j]] = [copy[j], copy[i]];
  }
  return copy;
}

const SUB_COLS    = 4;
const subSpeeds   = [230, 290, 195, 260] as const;
const subDelays   = [0, -95, -45, -165]  as const;

const subShuffled = seededShuffle(s.fotos as Foto[], 42);
const subChunk    = Math.ceil(subShuffled.length / SUB_COLS);
const subColFotos = Array.from({ length: SUB_COLS }, (_, ci) =>
  subShuffled.slice(ci * subChunk, Math.min((ci + 1) * subChunk, subShuffled.length))
);

const pasos = s.pasos;
---

<Layout
  title={`${s.nombre} — Grupo Crear · Bogotá`}
  description={s.descripcionLarga}
>
  <RocketCursor slot="cursor" />

  <!-- ═══════════════════════════════════════
       STICKY NAV DE SERVICIOS
  ═══════════════════════════════════════ -->
  <div id="serv-nav" aria-label="Navegar entre servicios">
    <div class="sn-inner">
      {servicios.map((item) => (
        <a
          href={`/servicios/${item.slug}`}
          class={`sn-pill${item.slug === s.slug ? ' active' : ''}`}
          data-slug={item.slug}
        >
          {item.nombreCorto}
        </a>
      ))}
    </div>
  </div>

  <!-- ═══════════════════════════════════════
       1 · MISIÓN — promesa del servicio
  ═══════════════════════════════════════ -->
  <section id="sub-hero" class="sub-section" data-chapter="Misión" aria-labelledby="sub-h1">
    <div class="wrap sub-grid">
      <div class="sub-txt">
        <h1 class="sub-h1" id="sub-h1">
          <span class="ln"><span>{s.nombre.split(' ').slice(0,-1).join(' ')}</span></span>
          <span class="ln"><span><em>{s.nombre.split(' ').slice(-1)[0]}.</em></span></span>
        </h1>
        <p class="sub-desc" id="sub-desc">{s.descripcionLarga}</p>
        <div class="sub-acts" id="sub-acts">
          <a
            href={`${waBase}?text=${s.whatsappText}`}
            class="btn-fill"
            target="_blank"
            rel="noopener noreferrer"
          >
            Pedir cotización
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </a>
          <button class="btn-line" id="openContactSub">Más información</button>
        </div>
      </div>

      <div class="sub-img-wrap" id="sub-img-wrap">
        <div
          class="sub-frame"
          style={s.fotoPrincipal || s.videoPrincipal ? undefined : `background:${s.gradiente}`}
          aria-hidden="true"
        >
          {s.videoPrincipal ? (
            <video src={s.videoPrincipal} poster={s.fotoPrincipal || undefined} muted loop playsinline autoplay preload="metadata"></video>
          ) : s.fotoPrincipal && (
            <img src={s.fotoPrincipal} alt="" loading="eager" draggable="false" />
          )}
          <div class="sub-protect"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       2 · RETO — el problema que resuelve el servicio
  ═══════════════════════════════════════ -->
  <section id="reto" class="tone-paper" data-chapter="Reto" data-tone="light" aria-labelledby="reto-txt">
    <div class="wrap">
      <h2 class="reto-txt" id="reto-txt" set:html={s.reto}></h2>
    </div>
  </section>

  <!-- 3 · CARGA — lo que recibe el cliente -->
  <EntregablesSection entregables={s.entregables} />

  <!-- ═══════════════════════════════════════
       4 · RUTA — el cohete recorre los pasos
  ═══════════════════════════════════════ -->
  <section id="proceso" class="tone-paper" data-chapter="Ruta" data-tone="light" aria-labelledby="proc-title">
    <div class="wrap">
      <h2 class="lead" id="proc-title">Cómo <em>trabajamos.</em></h2>
      <div class="proc-track">
        <div class="proc-line" aria-hidden="true"><span class="proc-fill"></span></div>
        <span class="proc-rocket" aria-hidden="true"></span>
        {pasos.map((p) => (
          <div class="paso">
            <div class="paso-num">{p.num}</div>
            <div class="paso-body">
              <h3 class="paso-title">{p.titulo}</h3>
              <p class="paso-desc">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       5 · PRUEBAS — trabajo real (solo si hay fotos)
  ═══════════════════════════════════════ -->
  {hayFotos && (
    <section id="galeria-serv" class="sub-section" data-chapter="Pruebas" aria-labelledby="gal-serv-title">
      <div class="wrap">
        <h2 class="lead r" data-d="1" id="gal-serv-title">Proyectos de <em>{s.nombreCorto}.</em></h2>
        <div class="gal-sub-strip" id="galSubStrip">
          {subColFotos.map((colFotos, ci) => colFotos.length > 0 && (
            <div
              class={`gal-sub-col gal-sub-${ci % 2 === 0 ? 'up' : 'down'}`}
              style={`--spd:${subSpeeds[ci]}s; --dly:${subDelays[ci]}s`}
            >
              <div class="gal-sub-track">
                {/* Set A — ítems reales */}
                {colFotos.map((foto: Foto) => (
                  <div class="gal-item-sub">
                    <div class="gal-protect" aria-hidden="true"></div>
                    <img src={foto.src} alt={foto.alt} loading="lazy" draggable="false" />
                  </div>
                ))}
                {/* Set B — duplicado para loop sin costura */}
                {colFotos.map((foto: Foto) => (
                  <div class="gal-item-sub" aria-hidden="true">
                    <div class="gal-protect" aria-hidden="true"></div>
                    <img src={foto.src} alt="" loading="lazy" draggable="false" />
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════
       OTROS SERVICIOS
  ═══════════════════════════════════════ -->
  <section id="otros-serv" data-chapter="Flota" aria-labelledby="otros-title" class="sub-section">
    <div class="wrap">
      <div class="serv-head">
        <div>
          <h2 class="lead r" data-d="1" id="otros-title">También <em>hacemos.</em></h2>
        </div>
        <a href="/servicios" class="btn-line r" data-d="2">Ver todos →</a>
      </div>
      <div class="otros-grid">
        {otros.map((o, i) => (
          <a
            href={`/servicios/${o.slug}`}
            class="otro-card r"
            data-d={String((i % 3) + 1)}
            aria-label={o.nombre}
          >
            <div
              class="oc-img"
              style={o.fotoPrincipal
                ? `background-image:url(${o.fotoPrincipal})`
                : `background:${o.gradiente}`}
              aria-hidden="true"
            ></div>
            <div class="oc-overlay" aria-hidden="true"></div>
            <div class="oc-body">
              <h3 class="oc-title">{o.nombreCorto}</h3>
            </div>
            <div class="oc-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                <path d="M7 17L17 7M17 7H8M17 7v9"/>
              </svg>
            </div>
            <div class="oc-protect"></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 7 · ATERRIZAJE — clímax en naranja sólido -->
  <CierreCTA waHref={`${waBase}?text=${s.whatsappText}`} />

  <Footer />
  <ContactDialog />
</Layout>

<style>
/* ── LAYOUT BASE DE SUB-PÁGINAS ── */
.sub-section { background: var(--bg); }

/* Paneles claros: rompen el azul para que la lectura descanse y el contenido
   clave destaque. Tinta sobre papel = 16,76:1; acento --n-text = 4,67:1. */
.tone-paper {
  background: var(--paper);
  color: var(--ink);
  border-radius: clamp(20px, 3vw, 40px);
}
.tone-paper .lead { color: var(--ink); }
.tone-paper .lead em { color: var(--n-text); }

/* ── 1 · MISIÓN ── */
#sub-hero {
  position: relative;
  overflow: hidden;
  min-height: 100svh;
  display: flex;
  align-items: center;
  /* El nav es fixed: se compensa su alto y nada más */
  padding-top: calc(84px + clamp(16px, 2.5vw, 32px));
  padding-bottom: clamp(40px, 5vw, 72px);
  background:
    radial-gradient(70vw 70vw at 100% 0%, rgba(232, 78, 27, .16), transparent 62%),
    var(--bg);
}
.sub-grid {
  width: 100%;
  display: grid;
  grid-template-columns: 1.05fr 1fr;
  gap: clamp(32px, 5vw, 72px);
  align-items: center;
}
.sub-h1 {
  font-family: 'Sofia Sans Condensed', sans-serif;
  font-weight: 900;
  font-size: clamp(50px, 7.4vw, 112px);
  line-height: .9;
  letter-spacing: -.04em;
  text-transform: uppercase;
  margin-bottom: clamp(20px, 2.6vw, 32px);
}
.sub-h1 em { font-style: normal; color: var(--n); }
.sub-h1 .ln { display: block; overflow: hidden; padding-top: .12em; margin-top: -.12em; }
.sub-h1 .ln span { display: block; }

.sub-desc {
  font-size: clamp(16px, 1.4vw, 19px);
  color: var(--w60); line-height: 1.65;
  max-width: 520px; margin-bottom: clamp(24px, 3vw, 36px);
}
.sub-acts { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }

.sub-frame {
  position: relative;
  border-radius: 12px; overflow: hidden;
  aspect-ratio: 4/5;
  max-height: calc(100svh - 150px);
  width: 100%;
}
/* 116 % de alto: margen para el parallax interno sin dejar bordes vacíos */
.sub-frame img,
.sub-frame video {
  position: absolute; left: 0; top: -8%;
  width: 100%; height: 116%;
  object-fit: cover; display: block;
}
.sub-protect { position: absolute; inset: 0; z-index: 2; }

@media (max-width: 860px) {
  #sub-hero { min-height: 0; }
  .sub-grid { grid-template-columns: 1fr; }
  .sub-frame { aspect-ratio: 4/3; max-height: none; }
}

/* ── 2 · RETO ── */
#reto { min-height: 92svh; display: flex; align-items: center; }
#reto .wrap { width: 100%; }
@media (max-width: 860px) { #reto { min-height: 72svh; } }
.reto-txt {
  font-family: 'Sofia Sans Condensed', sans-serif;
  font-weight: 800;
  font-size: clamp(36px, 6vw, 92px);
  line-height: 1;
  letter-spacing: -.03em;
  max-width: 19em;
  color: var(--ink);
}
.reto-txt :global(em) { font-style: normal; color: var(--n-text); }

/* ── 4 · RUTA ── */
/* Alto de pantalla completa para que quede estable mientras está fija;
   el padding superior libra el navbar y la barra de servicios */
#proceso {
  min-height: 100svh;
  padding-top: 150px;
  padding-bottom: clamp(40px, 6vh, 72px);
  display: flex; flex-direction: column; justify-content: center;
}
#proceso .wrap { width: 100%; }
.proc-track {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: clamp(20px, 3vw, 44px);
  position: relative;
  margin-top: clamp(64px, 8vh, 96px);
}
/* De la primera bolita a la última: la columna 4 empieza en el 75 % + un cuarto del gap */
.proc-line {
  position: absolute; top: 27px; left: 28px;
  right: calc(25% - 28px - clamp(20px, 3vw, 44px) * .25);
  height: 2px;
  background: rgba(4, 16, 42, .16);
}
.proc-fill {
  position: absolute; inset: 0;
  background: var(--n);
  transform: scaleX(0); transform-origin: left;
}
/* Corre sobre la línea, por encima de las bolitas, y se detiene antes de la última */
.proc-rocket {
  position: absolute; left: 60px; top: 6px; z-index: 2;
  width: 44px; height: 44px;
}
.proc-rocket :global(svg) { width: 100%; height: 100%; transform: rotate(90deg); display: block; }

.paso-num {
  width: 56px; height: 56px; border-radius: 50%;
  background: var(--paper); color: var(--ink);
  border: 2px solid var(--ink);
  font-family: 'Sofia Sans Condensed', sans-serif;
  font-size: 22px; font-weight: 900;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 22px; position: relative; z-index: 1;
  transition: background .3s, border-color .3s, transform .4s var(--ease);
}
.paso:global(.on) .paso-num { background: var(--n); border-color: var(--n); transform: scale(1.08); }
.paso-title {
  font-family: 'Sofia Sans Condensed', sans-serif;
  font-size: clamp(22px, 2vw, 28px); font-weight: 800; text-transform: uppercase;
  line-height: 1.05;
  margin-bottom: 10px; color: var(--ink);
}
.paso-desc { font-size: 16px; color: rgba(4, 16, 42, .78); line-height: 1.55; }

@media (max-width: 1023px) {
  .proc-track { grid-template-columns: 1fr; gap: 32px; }
  .proc-line { top: 28px; bottom: 60px; left: 27px; right: auto; width: 2px; height: auto; }
  .proc-fill { transform: scaleY(0); transform-origin: top; }
  .proc-rocket { display: none; }
  .paso { display: grid; grid-template-columns: 56px 1fr; gap: 18px; align-items: start; }
  .paso-num { margin-bottom: 0; }
}
/* Sin movimiento: la ruta se muestra completa */
@media (prefers-reduced-motion: reduce) {
  .proc-fill { transform: none; }
  .proc-rocket { display: none; }
  .paso-num { background: var(--n); border-color: var(--n); }
  .gal-sub-track { animation: none !important; }
}

/* ── GALERÍA SUB — Film Strips ── */
#galeria-serv { padding-left: 0; padding-right: 0; }

.gal-sub-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: clamp(8px, 1vw, 12px);
  height: 82vh;
  min-height: 500px;
  overflow: hidden;
  margin-top: clamp(28px,4vw,48px);
  mask-image: linear-gradient(to bottom, transparent 0%, #000 7%, #000 93%, transparent 100%);
  -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 7%, #000 93%, transparent 100%);
}

.gal-sub-col   { overflow: hidden; position: relative; }
.gal-sub-track {
  display: flex; flex-direction: column;
  gap: clamp(8px, 1vw, 12px);
  will-change: transform;
}

.gal-sub-up .gal-sub-track {
  animation: strip-up var(--spd, 230s) linear infinite;
  animation-delay: var(--dly, 0s);
}
.gal-sub-down .gal-sub-track {
  animation: strip-down var(--spd, 260s) linear infinite;
  animation-delay: var(--dly, 0s);
}
.gal-sub-col:hover .gal-sub-track { animation-play-state: paused; }

@keyframes strip-up   { from { transform:translateY(0) } to { transform:translateY(-50%) } }
@keyframes strip-down { from { transform:translateY(-50%) } to { transform:translateY(0) } }

.gal-item-sub {
  position: relative; border-radius: 8px; overflow: hidden; flex-shrink: 0;
}
.gal-item-sub img {
  width: 100%; display: block; object-fit: cover;
  pointer-events: none; -webkit-user-drag: none;
  transition: transform .9s var(--ease);
}
/* Mismo patrón de 7 alturas que la galería overview — referencia masonry variado */
.gal-item-sub:nth-child(7n+1) img { height: clamp(195px,18vw,270px); }  /* paisaje 4:3 */
.gal-item-sub:nth-child(7n+2) img { height: clamp(340px,32vw,440px); }  /* retrato alto 2:3 */
.gal-item-sub:nth-child(7n+3) img { height: clamp(145px,13vw,195px); }  /* panorámico 16:9 */
.gal-item-sub:nth-child(7n+4) img { height: clamp(265px,25vw,355px); }  /* retrato 3:4 */
.gal-item-sub:nth-child(7n+5) img { height: clamp(215px,20vw,285px); }  /* cuadrado aprox. */
.gal-item-sub:nth-child(7n+6) img { height: clamp(295px,28vw,395px); }  /* retrato muy alto */
.gal-item-sub:nth-child(7n+7) img { height: clamp(165px,15vw,225px); }  /* paisaje corto */
.gal-item-sub:hover img { transform: scale(1.04); }

.gal-protect { position: absolute; inset: 0; z-index: 2; }

/* Spotlight de cursor */
.gal-item-sub::after {
  content: ''; position: absolute; inset: 0; z-index: 3; pointer-events: none;
  opacity: 0; border-radius: inherit;
  background: radial-gradient(160px at var(--mx,50%) var(--my,50%),rgba(232,78,27,.12),transparent 70%);
  transition: opacity .3s;
}
.gal-item-sub:hover::after { opacity: 1; }

@media (max-width: 900px)  { .gal-sub-strip { grid-template-columns: repeat(3, 1fr); height: 70vh; } }
@media (max-width: 580px)  { .gal-sub-strip { grid-template-columns: repeat(2, 1fr); height: 60vh; } }

/* ── OTROS SERVICIOS ── */
.otros-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: clamp(10px,1.2vw,14px);
  margin-top: clamp(36px,5vw,56px);
}
.otro-card {
  position: relative;
  border-radius: 8px; overflow: hidden;
  min-height: 180px;
  text-decoration: none; cursor: none;
  border: 1px solid var(--w06);
  transition: border-color .4s var(--ease);
  display: flex; flex-direction: column; justify-content: flex-end;
}
.otro-card:hover { border-color: rgba(232,78,27,.35); }
.otro-card:hover .oc-img { transform: scale(1.06); }
.otro-card:hover .oc-arrow { opacity: 1; transform: none; }

.oc-img {
  position: absolute; inset: 0;
  background-position: center;
  background-size: cover;
  background-repeat: no-repeat;
  transition: transform .8s var(--ease);
}
.oc-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,12,36,.92) 0%, transparent 60%);
}
.oc-body { position: relative; z-index: 2; padding: 16px; }
.oc-title {
  font-family: 'Sofia Sans Condensed',sans-serif;
  font-size: 18px; font-weight: 800; text-transform: uppercase;
  color: #fff; line-height: 1;
}
.oc-arrow {
  position: absolute; top: 14px; right: 14px; z-index: 2;
  width: 36px; height: 36px;
  border: 1px solid var(--w12); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  opacity: 0; transform: translate(-4px,4px);
  transition: .4s var(--ease);
}
.oc-arrow svg { width: 13px; height: 13px; stroke: #fff; }
.oc-protect { position: absolute; inset: 0; z-index: 1; }

@media (max-width: 1024px) { .otros-grid { grid-template-columns: repeat(3,1fr); } }
@media (max-width: 680px)  { .otros-grid { grid-template-columns: repeat(2,1fr); } }

/* ── STICKY NAV (CÁPSULA FLOTANTE PREMIUM) ── */
#serv-nav {
  position: fixed;
  top: 92px; /* Justo debajo del navbar */
  left: 50%;
  z-index: 200;
  width: max-content;
  max-width: calc(100vw - 40px);
  background: rgba(0, 16, 42, 0.94);
  backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 100px;
  padding: 6px;
  box-shadow: 
    0 16px 36px rgba(0, 0, 0, 0.5), 
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
  /* Oculto por defecto */
  opacity: 0;
  visibility: hidden;
  transform: translate(-50%, -10px) scale(0.95);
  transition: 
    opacity 0.4s var(--ease), 
    visibility 0.4s var(--ease), 
    transform 0.4s var(--ease);
}
#serv-nav.visible {
  opacity: 1;
  visibility: visible;
  transform: translate(-50%, 0) scale(1);
}
.sn-inner {
  display: flex;
  gap: 4px;
  overflow-x: auto;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
.sn-inner::-webkit-scrollbar { display: none; }

.sn-pill {
  flex-shrink: 0;
  font-family: 'Sofia Sans Condensed', sans-serif;
  font-size: 11px;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--w60);
  border: 1px solid transparent;
  border-radius: 100px;
  padding: 7px 16px;
  background: transparent;
  cursor: none;
  transition: .3s var(--ease);
  white-space: nowrap;
}
.sn-pill:hover { 
  color: #fff; 
  background: var(--n); 
  border-color: var(--n); 
}
.sn-pill.active { 
  color: var(--n); 
  font-weight: 700;
}
</style>

<script>
  import { gsap, ScrollTrigger } from '../../utils/gsap-config';
  import { cloneRocket } from '../../scripts/story';

  const prefersRM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── STICKY NAV REVEAL ON SCROLL ── */
  ScrollTrigger.create({
    trigger: '#sub-hero',
    start: 'bottom top+=92',
    onEnter: () => document.getElementById('serv-nav')?.classList.add('visible'),
    onLeaveBack: () => document.getElementById('serv-nav')?.classList.remove('visible'),
    onRefresh: (self) => {
      const nav = document.getElementById('serv-nav');
      if (self.progress > 0) {
        nav?.classList.add('visible');
      } else {
        nav?.classList.remove('visible');
      }
    }
  });

  /* Parte el texto en palabras conservando los <em> (el texto sigue siendo texto) */
  const splitWords = (root: HTMLElement) => {
    const walk = (node: Node) => {
      [...node.childNodes].forEach((c) => {
        if (c.nodeType !== Node.TEXT_NODE) return walk(c);
        const frag = document.createDocumentFragment();
        (c.textContent ?? '').split(/(\s+)/).forEach((t) => {
          if (!t.trim()) return frag.append(t);
          const w = document.createElement('span');
          w.className = 'w';
          w.textContent = t;
          frag.append(w);
        });
        c.replaceWith(frag);
      });
    };
    walk(root);
    return [...root.querySelectorAll<HTMLElement>('.w')];
  };

  const pasos = gsap.utils.toArray<HTMLElement>('.paso');
  const mm = gsap.matchMedia();

  mm.add('(prefers-reduced-motion: no-preference)', () => {
    /* 1 · Misión: entrada y parallax interno de la imagen */
    gsap.timeline({ defaults: { ease: 'expo.out' } })
      .from('.sub-h1 .ln > span', { yPercent: 105, stagger: .12, duration: 1 }, .1)
      .from(['.sub-desc', '.sub-acts'], { opacity: 0, y: 20, stagger: .1, duration: .8 }, .45)
      .fromTo('.sub-frame',
        { clipPath: 'inset(12% 8% 12% 8% round 12px)', opacity: 0 },
        { clipPath: 'inset(0% 0% 0% 0% round 12px)', opacity: 1, duration: 1.2 }, .2);
    const media = document.querySelector('.sub-frame img, .sub-frame video');
    if (media) {
      gsap.to(media, {
        yPercent: -7, ease: 'none',
        scrollTrigger: { trigger: '#sub-hero', start: 'top top', end: 'bottom top', scrub: true },
      });
    }

    /* 2 · Reto: el panel claro se abre y la frase se enciende palabra por palabra */
    gsap.fromTo('#reto',
      { clipPath: 'inset(0% 5% 0% 5% round 40px)' },
      {
        clipPath: 'inset(0% 0% 0% 0% round 40px)', ease: 'none',
        scrollTrigger: { trigger: '#reto', start: 'top bottom', end: 'top 40%', scrub: true },
      });
    const reto = document.querySelector<HTMLElement>('.reto-txt');
    if (reto) {
      gsap.fromTo(splitWords(reto),
        { opacity: .14 },
        {
          opacity: 1, ease: 'none', stagger: .06,
          scrollTrigger: { trigger: reto, start: 'top 82%', end: 'bottom 55%', scrub: .5 },
        });
    }

    /* 5 · Pruebas: la galería entra con una leve subida */
    if (document.getElementById('galSubStrip')) {
      gsap.from('#galSubStrip', {
        y: 60, opacity: 0, duration: 1.1, ease: 'expo.out',
        scrollTrigger: { trigger: '#galSubStrip', start: 'top 85%', once: true },
      });
    }
  });

  /* 4 · Ruta (escritorio): sección fija; el cohete recorre la línea y enciende cada paso */
  mm.add('(min-width: 1024px) and (prefers-reduced-motion: no-preference)', () => {
    const line   = document.querySelector<HTMLElement>('.proc-line');
    const holder = document.querySelector<HTMLElement>('.proc-rocket');
    if (!line || !holder) return;
    const rocket = cloneRocket();
    if (rocket) holder.replaceChildren(rocket);

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#proceso', pin: true, start: 'top top', end: '+=150%',
        scrub: .6, invalidateOnRefresh: true,
      },
      onUpdate() {
        const p = tl.progress();
        pasos.forEach((el, i) => el.classList.toggle('on', p >= i / (pasos.length - 1) - .02));
      },
    });
    tl.to('.proc-fill', { scaleX: 1, ease: 'none', duration: 1 }, 0)
      .to(holder, { x: () => line.offsetWidth - 92, ease: 'none', duration: 1 }, 0);
    pasos[0]?.classList.add('on');

    return () => {
      holder.replaceChildren();
      pasos.forEach((el) => el.classList.remove('on'));
    };
  });

  /* 4 · Ruta (móvil/tablet): la línea baja con el scroll y cada paso se enciende al llegar */
  mm.add('(max-width: 1023px) and (prefers-reduced-motion: no-preference)', () => {
    gsap.to('.proc-fill', {
      scaleY: 1, ease: 'none',
      scrollTrigger: { trigger: '.proc-track', start: 'top 70%', end: 'bottom 70%', scrub: true },
    });
    pasos.forEach((el) => {
      ScrollTrigger.create({ trigger: el, start: 'top 70%', toggleClass: 'on' });
    });
  });

  /* Layout crea los capítulos del HUD cuando los pins ya existen */
  (window as any).__storyReady = true;
  window.dispatchEvent(new CustomEvent('story:ready'));
  ScrollTrigger.sort();
  ScrollTrigger.refresh();
  document.fonts?.ready.then(() => ScrollTrigger.refresh());

  /* ── GALERÍA SUB — Strips usan CSS animation; solo spotlight de cursor ── */
  document.querySelectorAll<HTMLElement>('.gal-item-sub').forEach(item => {
    item.addEventListener('mousemove', (e: MouseEvent) => {
      const r = item.getBoundingClientRect();
      item.style.setProperty('--mx', `${((e.clientX - r.left) / r.width  * 100).toFixed(1)}%`);
      item.style.setProperty('--my', `${((e.clientY - r.top)  / r.height * 100).toFixed(1)}%`);
    });
  });

  /* ── PROTECCIÓN DE IMÁGENES ── */
  ['#galeria-serv','#otros-serv','#sub-hero'].forEach(sel => {
    document.querySelector(sel)?.addEventListener('contextmenu', e => e.preventDefault());
    document.querySelector(sel)?.addEventListener('dragstart',   e => e.preventDefault());
  });

  /* ── CTAs → ContactDialog ── */
  const openDialog = () => {
    document.querySelector<HTMLDialogElement>('#contact-dialog')?.showModal();
  };
  document.getElementById('openContactSub')?.addEventListener('click', openDialog);

</script>
